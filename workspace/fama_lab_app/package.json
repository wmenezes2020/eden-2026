{
  "name": "bateu-curtiu",
  "version": "1.0.0",
  "description": "BATEU, CURTIU - Premium Music & Entertainment Platform",
  "main": "www/js/app.js",
  "scripts": {
    "build": "npm run build:js && npm run build:css",
    "build:js": "terser www/js/app.js -o www/js/app.min.js --compress --mangle",
    "build:css": "npm run build:css:prod",
    "build:css:prod": "cleancss -o www/css/app.min.css www/css/app.css",
    "start": "cordova run android --device",
    "build:android": "cordova build android --release -- --keystore=release.keystore",
    "prepare": "capacitor sync android"
  },
  "keywords": [
    "cordova",
    "android",
    "ios",
    "mobile",
    "music",
    "streaming",
    "entertainment"
  ],
  "author": "FamaLab Team",
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^5.0.0",
    "@capacitor/app": "^5.0.0",
    "@capacitor/core": "^5.0.0",
    "@capacitor/haptics": "^5.0.0",
    "@capacitor/local-notifications": "^5.0.0",
    "@capacitor/network": "^5.0.0",
    "@capacitor/preferences": "^5.0.0",
    "@capacitor/push-notifications": "^5.0.0",
    "@capacitor/status-bar": "^5.0.0",
    "@capacitor/storage": "^5.0.0",
    "cordova-android": "^12.0.0",
    "cordova-ios": "^7.0.0",
    "cordova-plugin-androidx": "^3.0.0",
    "cordova-plugin-androidx-adapter": "^1.1.3",
    "cordova-plugin-badge": "^0.8.9",
    "cordova-plugin-file": "^8.1.0",
    "cordova-plugin-local-notification": "^0.9.0",
    "cordova-plugin-media": "^7.0.0",
    "cordova-plugin-media-session": "^1.0.3",
    "cordova-plugin-network-information": "^3.0.0",
    "cordova-plugin-screen-orientation": "^3.0.2",
    "cordova-plugin-statusbar": "^3.0.0",
    "vue": "^3.3.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^5.0.0",
    "clean-css-cli": "^5.6.2",
    "cordova-res": "^0.15.4",
    "terser": "^5.19.0"
  },
  "cordova": {
    "plugins": {
      "cordova-plugin-screen-orientation": {},
      "cordova-plugin-statusbar": {},
      "cordova-plugin-file": {},
      "cordova-plugin-media": {},
      "cordova-plugin-media-session": {},
      "cordova-plugin-network-information": {},
      "cordova-plugin-local-notification": {},
      "cordova-plugin-badge": {},
      "cordova-plugin-androidx": {},
      "cordova-plugin-androidx-adapter": {}
    },
    "platforms": [
      "android",
      "ios"
    ]
  }
}
